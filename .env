# SafeGuard AI Configuration

# SendGrid API Key (RECOMMENDED - Get from https://app.sendgrid.com/settings/api_keys)
# Free tier: 100 emails/day
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# Fallback Django Email Settings (only used if SendGrid fails)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=SafeGuard AI <your_email@gmail.com>

# Malert SMS Gateway (apps.malert.io) - employee login & violation SMS alerts
MALERT_USERNAME=HAEGLTECH
MALERT_API_PASSWORD=PRPatil@5077
